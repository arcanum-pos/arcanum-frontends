{
  "name": "arcanum-frontends",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "screenshots": "playwright test -c playwright.screenshots.config.ts",
    "review-pack": "node scripts/review-pack.mjs",
    "build:node": "esbuild worker/node.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist-node/server.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "start:node": "node dist-node/server.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.46",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "hono": "^4.13.14",
    "lucide-react": "^1.62.0",
    "modern-screenshot": "^4.7.0",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "^9.3.13",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "fast-check": "^4.10.2",
    "oxlint": "^1.90.0",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.4",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.132.0"
  }
}
