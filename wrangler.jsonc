{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "arcanum-frontends",
	"main": "worker/index.ts",
	"compatibility_date": "2026-09-15",
	"dev": {
		// Next free port after devicehub's 8790/9790 — see LOCAL_DEV.md in the
		// arcanum folder for the full port map across all Workers.
		"port": 8791,
		"inspector_port": 9791
	},
	"assets": {
		// Vite's build output (npm run build) — multi-entry (see vite.config.ts):
		// one HTML file + its own JS/CSS bundle per screen/app, plus whatever
		// shared chunks Rollup factors out across them.
		"directory": "./dist",
		"binding": "ASSETS",
		// Without this a request for an existing file never reaches
		// worker/index.ts, and the pages go out without their
		// Content-Security-Policy. The hashed bundles need no header.
		"run_worker_first": ["/*", "!/assets/*"]
	},
	// No custom domain and no public route here, same reasoning as
	// arcanum-webapp: reached only through arcanum-bff via a service binding,
	// never directly. workers_dev defaults to true when unset, so this must
	// be pinned explicitly — same fix as arcanum-backend's own workers_dev:
	// false (this repo and arcanum-webapp were both missing it despite the
	// comment above already claiming the intent).
	"workers_dev": false,
	"observability": {
		"enabled": true
	}
}
